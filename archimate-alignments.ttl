@prefix am:     <https://w3id.org/archimate#> .
@prefix am32:   <https://purl.org/archimate#> .
@prefix bp4mc2: <http://bp4mc2.org/def/archimate#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

# GEGENEREERD BESTAND; niet met de hand bewerken.
# Generator: scripts/generate_alignments.py
# Alleen naar termen die in de bron echt bestaan; bronnen vast op een commit.

<https://w3id.org/archimate/alignments>
    a owl:Ontology ;
    rdfs:label "ArchiMate-alignments"@nl , "ArchiMate alignments"@en ;
    dcterms:description "Koppelingen van de ArchiMate 4.0-ontologie naar eerdere ArchiMate-ontologieën in RDF."@nl , "Mappings from the ArchiMate 4.0 ontology to earlier ArchiMate ontologies in RDF."@en ;
    dcterms:references <https://purl.org/archimate/owl> ;
    dcterms:references <http://bp4mc2.org/def/archimate> ;
    owl:imports <https://w3id.org/archimate> ;
    owl:versionInfo "0.3.0-concept" .

# ArchiMate 3.2 ontology (Alberto D. Mendoza): 81 koppelingen
am:ApplicationCollaboration skos:exactMatch am32:ApplicationCollaboration .
am:ApplicationComponent skos:exactMatch am32:ApplicationComponent .
am:ApplicationEvent skos:exactMatch am32:ApplicationEvent .
am:ApplicationFunction skos:exactMatch am32:ApplicationFunction .
am:ApplicationInteraction skos:exactMatch am32:ApplicationInteraction .
am:ApplicationInterface skos:exactMatch am32:ApplicationInterface .
am:ApplicationProcess skos:exactMatch am32:ApplicationProcess .
am:ApplicationService skos:exactMatch am32:ApplicationService .
am:Artifact skos:exactMatch am32:Artifact .
am:Assessment skos:exactMatch am32:Assessment .
am:BusinessActor skos:exactMatch am32:BusinessActor .
am:BusinessCollaboration skos:exactMatch am32:BusinessCollaboration .
am:BusinessEvent skos:exactMatch am32:BusinessEvent .
am:BusinessFunction skos:exactMatch am32:BusinessFunction .
am:BusinessInteraction skos:exactMatch am32:BusinessInteraction .
am:BusinessInterface skos:exactMatch am32:BusinessInterface .
am:BusinessObject skos:exactMatch am32:BusinessObject .
am:BusinessProcess skos:exactMatch am32:BusinessProcess .
am:BusinessRole skos:exactMatch am32:BusinessRole .
am:BusinessService skos:exactMatch am32:BusinessService .
am:Capability skos:exactMatch am32:Capability .
am:CommunicationNetwork skos:exactMatch am32:CommunicationNetwork .
am:CompositeElement skos:exactMatch am32:CompositeElement .
am:Concept skos:exactMatch am32:Concept .
am:Constraint skos:exactMatch am32:Constraint .
am:Contract skos:exactMatch am32:Contract .
am:CourseOfAction skos:exactMatch am32:CourseOfAction .
am:DataObject skos:exactMatch am32:DataObject .
am:Deliverable skos:exactMatch am32:Deliverable .
am:Device skos:exactMatch am32:Device .
am:DistributionNetwork skos:exactMatch am32:DistributionNetwork .
am:Driver skos:exactMatch am32:Driver .
am:Element skos:exactMatch am32:Element .
am:Equipment skos:exactMatch am32:Equipment .
am:Facility skos:exactMatch am32:Facility .
am:Gap skos:exactMatch am32:Gap .
am:Goal skos:exactMatch am32:Goal .
am:Grouping skos:exactMatch am32:Grouping .
am:ImplementationEvent skos:exactMatch am32:ImplementationEvent .
am:Junction skos:exactMatch am32:Junction .
am:Layer skos:exactMatch am32:Layer .
am:Location skos:exactMatch am32:Location .
am:Material skos:exactMatch am32:Material .
am:Meaning skos:exactMatch am32:Meaning .
am:Node skos:exactMatch am32:Node .
am:Outcome skos:exactMatch am32:Outcome .
am:Path skos:exactMatch am32:Path .
am:Plateau skos:exactMatch am32:Plateau .
am:Principle skos:exactMatch am32:Principle .
am:Product skos:exactMatch am32:Product .
am:Relationship skos:exactMatch am32:Relationship .
am:RelationshipConnector skos:exactMatch am32:RelationshipConnector .
am:Representation skos:exactMatch am32:Representation .
am:Requirement skos:exactMatch am32:Requirement .
am:Resource skos:exactMatch am32:Resource .
am:Stakeholder skos:exactMatch am32:Stakeholder .
am:SystemSoftware skos:exactMatch am32:SystemSoftware .
am:TechnologyCollaboration skos:exactMatch am32:TechnologyCollaboration .
am:TechnologyEvent skos:exactMatch am32:TechnologyEvent .
am:TechnologyFunction skos:exactMatch am32:TechnologyFunction .
am:TechnologyInteraction skos:exactMatch am32:TechnologyInteraction .
am:TechnologyInterface skos:exactMatch am32:TechnologyInterface .
am:TechnologyProcess skos:exactMatch am32:TechnologyProcess .
am:TechnologyService skos:exactMatch am32:TechnologyService .
am:Value skos:exactMatch am32:Value .
am:ValueStream skos:exactMatch am32:ValueStream .
am:WorkPackage skos:exactMatch am32:WorkPackage .
am:identifier skos:exactMatch am32:identifier .
am:isDirected skos:exactMatch am32:isDirected .
am:accesses skos:closeMatch am32:access .
am:aggregates skos:closeMatch am32:aggregation .
am:assignedTo skos:closeMatch am32:assignment .
am:associatedWith skos:closeMatch am32:association .
am:composes skos:closeMatch am32:composition .
am:flowsTo skos:closeMatch am32:flow .
am:influences skos:closeMatch am32:influence .
am:realizes skos:closeMatch am32:realization .
am:serves skos:closeMatch am32:serving .
am:specializes skos:closeMatch am32:specialization .
am:triggers skos:closeMatch am32:triggering .
am:View skos:closeMatch am32:ArchiMateView .

